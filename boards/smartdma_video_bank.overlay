/* SPDX-License-Identifier: MIT */
/* Experimental: carve the final 64 KiB bank out of the CPU0's 320 KiB RAM.
 * The CPU/USB allocations remain in the first 256 KiB, while the one-frame
 * SmartDMA video source occupies its own physical bank at 0x30040000.
 */
#include <zephyr/dt-bindings/memory-attr/memory-attr-arm.h>

&sram0 {
	reg = <0x20000000 0x00040000>;
};

&sram {
	video_ram_bank: memory@20040000 {
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <0x20040000 0x00010000>;
		zephyr,memory-region = "VIDEO_RAM";
		zephyr,memory-attr = <DT_MEM_ARM(ATTR_MPU_RAM)>;
	};
};
